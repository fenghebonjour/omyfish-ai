# Copy to .env (gitignored) and fill in real values for local `docker compose up`.
# In the deployed Hugging Face Space, these are set as Space secrets instead —
# this file has no effect there.

# Required for the Regs & Tips /regs/ask endpoint (regs_advisor/providers/llm_client.py).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional, defaults to llama-3.3-70b-versatile if unset.
# REGS_CHAT_MODEL=llama-3.3-70b-versatile

# Required for the Bite Score /bite-score/forecast endpoint
# (bite_prediction/providers/weather_client.py).
# Get a free key at https://openweathermap.org/api/one-call-3
OPENWEATHERMAP_API_KEY=
